{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "rsl",
      "camelcase": "RSL",
      "title": "tree-sitter-rsl",
      "scope": "source.rsl",
      "file-types": ["rsl"],
      "injection-regex": "^rsl$",
      "class-name": "TreeSitterRsl"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree sitter for RSL",
    "authors": [
      {
        "name": "M4ddCat",
        "url": ""
      }
    ],
    "links": {
      "repository": "https://github.com/M4ddCat/tree-sitter-rsl",
      "funding": ""
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
