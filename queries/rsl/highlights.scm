; ============================================
; Комментарии
; ============================================
(comment) @comment
(block_comment) @comment
(line_comment) @comment

; ============================================
; Строки
; ============================================
(string) @string
(string_literal) @string

; ============================================
; Числа
; ============================================
(number) @number
(integer) @number
(float) @number.float

; ============================================
; Ключевые слова управления
; ============================================
[
  "Import"
  "Break"
  "Continue"
  "Do"
  "Else"
  "For"
  "If"
  "Elif"
  "Return"
  "While"
  "Exit"
  "End"
  "Macro"
  "Class"
  "Var"
  "File"
] @keyword

; ============================================
; Базовые типы данных (из V_* констант)
; ============================================
[
  "V_GENOBJ"
  "V_DBFFILE"
  "V_TXTFILE"
  "V_ARRAY"
  "V_STRUC"
  "V_FILE"
  "V_UNDEF"
  "V_MONEYL"
  "V_MONEY"
  "V_NUMERIC"
  "V_DECIMAL"
  "V_R2M"
  "V_PROC"
  "V_MEMADDR"
  "V_DTTM"
  "V_TIME"
  "V_DATE"
  "V_BOOL"
  "V_STRING"
  "V_DOUBLEL"
  "V_DOUBLE"
  "V_INTEGER"
] @type.builtin

; ============================================
; Storage types (bool, string, integer и т.д.)
; ============================================
[
  "bool"
  "string"
  "integer"
  "array"
  "tarray"
  "file"
  "tbfile"
  "tbfilelog"
  "record"
  "object"
] @type

; ============================================
; Логические значения и this
; ============================================
[
  "true"
  "false"
  "this"
  "null"
] @constant.builtin

; ============================================
; Операторы
; ============================================
[
  "!="
  "<="
  ">="
  "=="
  "<"
  ">"
  "&"
  "|"
  "^"
  "~"
  "="
  "%"
  "*"
  "/"
  "-"
  "+"
  "++"
  "--"
  "and"
  "or"
  "not"
] @operator

; ============================================
; Разделители
; ============================================
[
  ";"
  ","
  "."
  ":"
] @punctuation.delimiter

; ============================================
; Скобки
; ============================================
[
  "("
  ")"
  "{"
  "}"
  "["
  "]"
] @punctuation.bracket

; ============================================
; Определения макросов
; ============================================
(macro_definition
  name: (identifier) @function) @item

; ============================================
; Вызовы функций/макросов
; ============================================
(macro_call
  name: (identifier) @function.call)

; ============================================
; Переменные
; ============================================
(variable_declaration
  name: (identifier) @variable)

(identifier) @variable

; ============================================
; Параметры
; ============================================
(parameter
  (identifier) @parameter)

; ============================================
; Константы в верхнем регистре
; ============================================
(identifier) @constant
  (#match? @constant "^[A-ZЙЦУКЕНГШЩЗХФЫВАПРОЛДЖЭЪЯЧСМИТЬБЮ][A-Z0-9_ЙЦУКЕНГШЩЗХФЫВАПРОЛДЖЭЪЯЧСМИТЬБЮ]*$")